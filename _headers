/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# HTML: no rule needed. Pages serves pages at extensionless paths (/bandit.html
# 308s to /bandit) with "public, max-age=0, must-revalidate" by default.

# 7-day cache: bump the ?v= token on main.css, its @imports and the JS
# when CSS or JS changes (see CLAUDE.md, Important Notes 7).
/styles/*
  Cache-Control: public, max-age=604800

# In production the zone's Browser Cache TTL (4h) overrides this no-cache,
# which is why /js/* URLs are versioned too.
/js/*
  Cache-Control: no-cache, must-revalidate

# Also covers the favicon (/images/favicon.png).
/images/*
  Cache-Control: public, max-age=604800

# Open the resume in the browser (not a forced download). Asks for a 1 hour
# cache, but the zone's Browser Cache TTL raises it to 4h in production, so a
# replaced resume.pdf can take up to 4 hours to show up.
/resume.pdf
  Content-Disposition: inline; filename="Nicolo_DiFerdinando_Resume.pdf"
  Cache-Control: public, max-age=3600, must-revalidate

# The build output is the repo root, so repo internals are deployed too.
# Keep them out of search results.
/docs/*
  X-Robots-Tag: noindex
/os/*
  X-Robots-Tag: noindex
/*.md
  X-Robots-Tag: noindex
/*.json
  X-Robots-Tag: noindex
